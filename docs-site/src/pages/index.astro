---
import { getCollection, render } from 'astro:content';
import HubDocsLayout from '../layouts/HubDocsLayout.astro';

const all = await getCollection('docs');
const entry = all.find((e) => e.id === '_index');
if (!entry) throw new Error('Missing src/content/docs/_index.md home content');
const { Content } = await render(entry);

const docs = all
  .filter((e) => e.id !== '_index')
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((e) => ({ id: e.id, title: e.data.title, description: e.data.description ?? '' }));

const BATCH = 4;
---

<HubDocsLayout title={undefined} description={entry.data.description} isHome>
  {entry.data.description && <p class="home-lede">{entry.data.description}</p>}
  <section class="card-grid" data-card-grid data-batch={BATCH}>
    {docs.map((doc, i) => (
      <a class="doc-card" href={`/${doc.id}.html`} hidden={i >= BATCH}>
        <span class="doc-card-title">{doc.title}</span>
        <span class="doc-card-desc">{doc.description}</span>
      </a>
    ))}
  </section>
  <div class="scroll-sentinel" data-sentinel aria-hidden="true"></div>
  <p class="scroll-end" data-scroll-end hidden>End of documents.</p>

  <hr>
  <div class="prose-home"><Content /></div>

  <script is:inline define:vars={{ batch: BATCH }}>
    (() => {
      const grid = document.querySelector('[data-card-grid]');
      const sentinel = document.querySelector('[data-sentinel]');
      const endNote = document.querySelector('[data-scroll-end]');
      if (!grid || !sentinel) return;
      let shown = batch;
      const reveal = () => {
        const cards = grid.querySelectorAll('.doc-card[hidden]');
        for (let i = 0; i < batch && cards.length > 0; i++) cards[0].hidden = false;
        shown += batch;
        if (grid.querySelectorAll('.doc-card[hidden]').length === 0) {
          sentinel.remove();
          if (endNote) endNote.hidden = false;
          return true;
        }
        return false;
      };
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          if (reveal()) io.disconnect();
        }
      }, { rootMargin: '240px' });
      io.observe(sentinel);
    })();
  </script>
</HubDocsLayout>
