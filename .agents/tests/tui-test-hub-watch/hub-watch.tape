# Pixel print of `hub watch` — the live attention board TUI.
# Launches the real binary against the live hub (~/.hub/hub.sock).
Output .agents/tests/tui-test-hub-watch/hub-watch.png
Set Width 1200
Set Height 720
Set FontSize 14
Set Shell bash
Set TypingSpeed 5ms

Type "cd /Users/yuri/DotFiles/pi-extentions/pi-hub && bun cli/src/bin.ts watch"
Enter
Sleep 5s
